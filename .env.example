# Copy this file to .env and fill in your values — never commit .env itself
#
# Local dev quick-start (Docker):
#   docker run -d --name dqp-pg -e POSTGRES_USER=dqp -e POSTGRES_PASSWORD=<choose-a-password> \
#     -e POSTGRES_DB=dqp -p 5432:5432 postgres:16
#   docker run -d --name dqp-neo4j -e NEO4J_AUTH=neo4j/<choose-a-password> \
#     -p 7474:7474 -p 7687:7687 neo4j:5

DATABASE_URL=postgresql://dqp:<your-postgres-password>@localhost:5432/dqp
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Optional: restrict CORS to your deployed origin (defaults to localhost dev ports)
# ALLOWED_ORIGINS=https://your-app.onrender.com
